__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/
dist/
build/

# Tool caches. Not ignored by default; committing them adds churn on every run and
# makes `git status` useless for spotting real changes.
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Runtime artefacts
.usage.jsonl
.cache/
results/
.lightrag/

# Corpus is vendored, not committed. Re-fetched from a pinned commit; committing
# 155 vendored files would bury every real change in the diff.
corpus/

# Browser-automation screenshots from local UI checks
.playwright-mcp/

# Intermediate frames for the demo GIF. The GIF itself is committed; the frames are
# ~7MB of PNGs that only exist to be assembled into it.
docs/demo/frames/
