# Provider credentials. Never commit real values.
# Read from the environment only; the gateway does not accept keys in request bodies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local model server (Module 3+)
OLLAMA_HOST=http://localhost:11434

# Optional infrastructure (Module 6)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmgateway
PHOENIX_ENABLED=false

# Retrieval (Module 3)
LIGHTRAG_WORKING_DIR=./.lightrag
RERANKER_MODEL=BAAI/bge-reranker-base
